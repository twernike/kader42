[Desktop Entry]
# Der Name, der im Startmenü erscheint
Name=Kader⁴² App Store
GenericName=Software-Manager
Comment[de]=Apps finden und installieren für Kader⁴²
Comment[en]=Find and install apps for Kader⁴²
Comment[fr]=Rechercher et installer des applications pour Kader⁴²
Comment[nl]=Apps zoeken en installeren voor Kader⁴²

# Der Befehl zum Starten (Absoluter Pfad zu deinem Skript)
# Falls du eine virtuelle Umgebung nutzt, hier den Pfad zum venv-python angeben
Exec=python3 /user/bin/Kader42-App-Store

# Das Logo, das du bereits unter /usr/share/icons hast
Icon=/usr/share/icons/kader42-app-store.png

# Technische Details
Terminal=false
Type=Application
Categories=System;Settings;PackageManager;
StartupNotify=true

# WICHTIG für KDE Plasma Task-Gruppierung
StartupWMClass=app-store