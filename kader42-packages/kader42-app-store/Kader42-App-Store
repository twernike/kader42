import sys
import subprocess
import requests
import os
from PySide6.QtWidgets import (QApplication, QMainWindow, QWidget, QVBoxLayout, 
                             QHBoxLayout, QLabel, QLineEdit, QPushButton, 
                             QListWidget, QListWidgetItem, QScrollArea, QFrame)
from PySide6.QtCore import Qt, QSize, QProcess, QTimer
from PySide6.QtGui import QFont, QIcon, QPixmap

# ==========================================================
# 1. DIE APP-KARTE (Silent & Robust)
# ==========================================================
class AppCard(QFrame):
    def __init__(self, name, description, pkg_name, icon_name=None):
        super().__init__()
        self.pkg_name = pkg_name
        self.setObjectName("AppCard")
        self.status = self.check_status()
        
        self.setStyleSheet("""
            #AppCard { 
                background-color: #252525; border-radius: 12px; 
                padding: 15px; margin-bottom: 10px; border: 1px solid #333; 
            }
            #AppCard:hover { border: 1px solid #3daee9; background-color: #2a2a2a; }
        """)
        
        layout = QHBoxLayout(self)
        
        # Icon
        icon_label = QLabel()
        icon = QIcon.fromTheme(icon_name if icon_name else "package-x-generic", QIcon.fromTheme("package-x-generic"))
        icon_label.setPixmap(icon.pixmap(QSize(48, 48)))
        layout.addWidget(icon_label)
        
        # Text
        text_layout = QVBoxLayout()
        name_label = QLabel(name)
        name_label.setFont(QFont("Cantarell", 12, QFont.Weight.Bold))
        name_label.setStyleSheet("color: white; border: none; background: transparent;")
        
        # Beschreibung (Sprachen-Check)
        desc_text = description
        if isinstance(description, dict):
            desc_text = description.get("de", description.get("en", "Keine Beschreibung"))

        desc_label = QLabel(desc_text)
        desc_label.setStyleSheet("color: #bbb; font-size: 11px; border: none; background: transparent;")
        desc_label.setWordWrap(True)
        
        self.status_label = QLabel("")
        self.status_label.setStyleSheet("font-size: 10px; font-weight: bold; color: #3daee9; border: none;")
        
        text_layout.addWidget(name_label)
        text_layout.addWidget(desc_label)
        text_layout.addWidget(self.status_label)
        layout.addLayout(text_layout)
        
        # Buttons
        self.btn_container = QWidget()
        self.btn_container.setStyleSheet("border: none; background: transparent;")
        self.btn_layout = QHBoxLayout(self.btn_container)
        self.render_ui()
        layout.addWidget(self.btn_container)

    def check_status(self):
        try:
            check = subprocess.run(['pacman', '-Qq', self.pkg_name], capture_output=True)
            if check.returncode != 0: return 0
            upd = subprocess.run(['yay', '-Qu', self.pkg_name], capture_output=True, text=True)
            return 2 if self.pkg_name in upd.stdout else 1
        except: return 0

    def render_ui(self):
        while self.btn_layout.count():
            item = self.btn_layout.takeAt(0)
            if item.widget(): item.widget().deleteLater()
        
        if self.status == 0:
            self.add_action_button("list-add", "#3daee9", "install", "Installieren")
        else:
            if self.status == 2:
                self.add_action_button("system-software-update", "#f39c12", "update", "Update")
                self.status_label.setText("⭐ Update verfügbar!")
            else:
                self.status_label.setText("✓ Aktuell")
            self.add_action_button("edit-delete", "#e74c3c", "remove", "Entfernen")

    def add_action_button(self, icon, color, mode, tooltip):
        btn = QPushButton()
        btn.setIcon(QIcon.fromTheme(icon))
        btn.setFixedSize(40, 40)
        btn.setCursor(Qt.PointingHandCursor)
        btn.setStyleSheet(f"background-color: {color}; border-radius: 20px; border: none;")
        btn.clicked.connect(lambda: self.run_action_silent(mode))
        self.btn_layout.addWidget(btn)

    def run_action_silent(self, mode):
        self.btn_container.setEnabled(False)
        self.status_label.setText("⌛ Authentifizierung...")

        # Flag-Logik
        flag = "-S" if mode == "install" else "-Rns"
        if mode == "update": flag = "-Syuu"
        cmd_core = f"yay {flag} --noconfirm {self.pkg_name}"

        # Wir nutzen direkt pkexec statt kdesu
        # pkexec ist unter Arch/Plasma 6 deutlich zuverlässiger für sudo-User
        args = ["pkexec", "bash", "-c", cmd_core]
        
        try:
            proc = subprocess.Popen(args)
            def check_loop():
                if proc.poll() is None:
                    QTimer.singleShot(2000, check_loop)
                else:
                    self.on_finished()
            check_loop()
        except Exception as e:
            print(f"Fehler: {e}")
            self.btn_container.setEnabled(True)

    def on_finished(self):
        self.status = self.check_status()
        self.btn_container.setEnabled(True)
        self.render_ui()

# ==========================================================
# 2. DAS HAUPTFENSTER (Mit Sidebar & Kategorie-Fix)
# ==========================================================
class KaderStore(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Kader⁴² App Store")
        self.resize(1150, 850)
        self.setStyleSheet("background-color: #1e1e1e; color: white;")
        
        self.apps_data = {"categories": [], "apps": {}}
        self.fetch_data()

        # Layout Setup
        central = QWidget()
        self.setCentralWidget(central)
        self.root = QVBoxLayout(central)
        
        # Header
        header = QHBoxLayout()
        logo = QLabel()
        l_path = "/usr/share/icons/kader42-app-store.png"
        if os.path.exists(l_path):
            logo.setPixmap(QPixmap(l_path).scaled(100, 100, Qt.KeepAspectRatio, Qt.SmoothTransformation))
        header.addWidget(logo)
        
        self.search = QLineEdit()
        self.search.setPlaceholderText("Apps suchen...")
        self.search.setFixedHeight(40)
        self.search.setStyleSheet("background: #2b2b2b; border-radius: 10px; padding: 5px; color: white;")
        header.addWidget(self.search)
        self.root.addLayout(header)

        # Content mit Sidebar
        content = QHBoxLayout()
        self.sidebar = QListWidget()
        self.sidebar.setFixedWidth(220)
        self.sidebar.setStyleSheet("QListWidget { background: transparent; border: none; } QListWidget::item { padding: 12px; } QListWidget::item:selected { background: #3daee9; border-radius: 8px; }")
        self.sidebar.currentRowChanged.connect(self.load_category)
        
        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        self.scroll.setStyleSheet("border: none;")
        self.list_widget = QWidget()
        self.list_layout = QVBoxLayout(self.list_widget)
        self.list_layout.setAlignment(Qt.AlignTop)
        self.scroll.setWidget(self.list_widget)
        
        content.addWidget(self.sidebar)
        content.addWidget(self.scroll)
        self.root.addLayout(content)
        
        self.setup_sidebar()

    def fetch_data(self):
        try:
            r = requests.get("https://kader42.de/repo/apps.json", timeout=5)
            raw = r.json()
            
            # DER FIX: Wenn es eine Liste ist, baue ein Fake-Kategorien-Dict
            if isinstance(raw, list):
                self.apps_data = {
                    "categories": [{"id": "main", "label": {"de": "Alle Apps", "en": "All Apps"}, "icon": "package-x-generic"}],
                    "apps": {"main": raw}
                }
            else:
                self.apps_data = raw
        except:
            pass

    def setup_sidebar(self):
        self.sidebar.clear()
        cats = self.apps_data.get("categories", [])
        for c in cats:
            name = c["label"].get("de", c["label"].get("en", "Apps"))
            item = QListWidgetItem(QIcon.fromTheme(c.get("icon", "package-x-generic")), name)
            item.setData(Qt.UserRole, c["id"])
            self.sidebar.addItem(item)
        if self.sidebar.count() > 0: self.sidebar.setCurrentRow(0)

    def load_category(self):
        while self.list_layout.count():
            item = self.list_layout.takeAt(0)
            if item.widget(): item.widget().deleteLater()
            
        cur = self.sidebar.currentItem()
        if not cur: return
        cat_id = cur.data(Qt.UserRole)
        apps = self.apps_data.get("apps", {}).get(cat_id, [])
        for a in apps:
            self.list_layout.addWidget(AppCard(a['name'], a.get('desc', ''), a['package'], a.get('icon')))

if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = KaderStore()
    window.show()
    sys.exit(app.exec())