[Unit]
Description=Kader⁴² Software Center REST API
After=network.target plasma-core.target

[Service]
Type=simple
WorkingDirectory=/usr/lib/kader42-software-center
ExecStart=/usr/bin/python3 /usr/lib/kader42-software-center/kader42-software-center-api.py
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=default.target