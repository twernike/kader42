    def on_json_loaded(self, reply):
        if reply.error() == QNetworkReply.NoError:
            path = reply.url().path()
            
            # Strikter Filter: Ignoriere alle Spezial-Routen!
            if path in ["/job", "/settings", "/self-update-check", "/jobs"] or path.startswith("/job/"):
                reply.deleteLater()
                return
            
            raw_data = reply.readAll().data().decode("utf-8").strip()
            if not raw_data:
                reply.deleteLater()
                return

            try:
                data = json.loads(raw_data)
                if path == "/categories":
                    self.apps_data = {"categories": data}
                    self.setup_sidebar()
                elif path in ["/apps", "/installed", "/updates"]:
                    self.clear_grid()
                    if path == "/updates":
                        total_updates = data.get("total_updates", 0)
                        packages = data.get("packages", [])
                        if total_updates > 0:
                            tmpl = _("updates_available_title")
                            title_text = tmpl % total_updates if "%s" in tmpl else f"{total_updates} Updates verfügbar"
                            self.update_status_title.setText(title_text)
                            self.update_all_btn.show()
                        else:
                            self.update_status_title.setText(_("system_up_to_date"))
                            self.update_all_btn.hide()
                        self.render_category_apps(packages)
                    else:
                        self.render_category_apps(data)
                        
            except Exception as e:
                print(f"❌ GUI Processing Error in {path}: {e}")
        else:
            print(f"❌ Network Error in GUI: {reply.errorString()}")
        reply.deleteLater()

