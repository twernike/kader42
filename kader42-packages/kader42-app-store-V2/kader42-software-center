    def render_category_apps(self, apps):
        columns = 3
        for index, a in enumerate(apps):
            pkg_lower = a.get('package_name', '').lower()
            if pkg_lower == "kader42-software-center":
                continue
                
            row = index // columns
            col = index % columns
            
            flat_id = None
            if "firefox" in pkg_lower: flat_id = "org.mozilla.firefox"
            elif "vlc" in pkg_lower: flat_id = "org.videolan.VLC"
            
            desc_key = a.get('description', '')
            source_str = str(a.get('source', 'repo')).upper()
            
            if desc_key == "desc_update_available":
                # Fängt fehlerhafte Format-Strings ab
                tmpl = _("desc_update_available")
                final_description = tmpl % source_str if "%s" in tmpl else f"Update in {source_str} verfügbar!"
            elif desc_key == "desc_installed_repo":
                final_description = _("desc_installed_repo")
            elif desc_key == "desc_installed_aur":
                final_description = _("desc_installed_aur")
            elif desc_key == "desc_generic_system":
                tmpl = _("desc_generic_system")
                final_description = tmpl % source_str if "%s" in tmpl else f"System-Paket ({source_str})"
            elif desc_key.startswith("desc_core_"):
                final_description = _(desc_key)
            else:
                final_description = desc_key

            card = AppCard(
                a.get('name', pkg_lower.capitalize()), 
                final_description, 
                a.get('package_name', ''), 
                icon_name="package-x-generic",
                source=a.get('source', 'repo'),
                flatpak_id=flat_id,
                status=a.get('status', 'available')
            )

            card.job_completed_signal.connect(
                lambda: QTimer.singleShot(400, self.refresh_current_view)
            )

            self.grid_layout.addWidget(card, row, col)


    def trigger_all_updates(self):
        print("📡 Sending POST request for global system update...")
        self.update_all_btn.setEnabled(False)
        self.update_status_title.setText(_("status_queue"))
        
        req = QNetworkRequest(QUrl(f"{API_URL}/job"))
        req.setHeader(QNetworkRequest.ContentTypeHeader, "application/json")
        job_data = {"package_name": "system-update", "source": "repo", "action": "update"}
        payload = json.dumps(job_data).encode("utf-8")
        
        reply = self.network_manager.post(req, payload)

        self.log_console.clear()
        self.log_console.show()
        
        def on_global_job_triggered():
            if reply.error() == QNetworkReply.NoError:
                try:
                    raw_res = reply.readAll().data().decode()
                    print(f"📡 API Response for POST /job: {raw_res}")
                    
                    res = json.loads(raw_res)
                    job_id = res.get("id")
                    
                    if not job_id:
                        print("❌ ERROR: No job ID returned by API!")
                        return

                    print(f"✅ Job started successfully! Polling status for Job ID: {job_id}")
                    
                    self.global_poll = QTimer(self)

                    def poll_global_status():
                        # 1. Status abfragen
                        p_req = QNetworkRequest(QUrl(f"{API_URL}/job/{job_id}"))
                        p_reply = self.poll_manager.get(p_req)
                        
                        def on_global_poll_fin():
                            if p_reply.error() == QNetworkReply.NoError:
                                raw_bytes = p_reply.readAll().data()
                                if raw_bytes:
                                    try:
                                        j_data = json.loads(raw_bytes.decode("utf-8").strip())
                                        status = j_data.get("status")
                                        
                                        # Status-Anzeige aktualisieren
                                        if status == "completed":
                                            self.global_poll.stop()
                                            self.update_status_title.setText(_("update_success"))
                                            self.update_status_title.setStyleSheet("font-size: 15px; font-weight: bold; color: #2ecc71;")
                                            self.update_all_btn.hide()
                                            self.refresh_current_view()
                                        elif status == "failed":
                                            self.global_poll.stop()
                                            self.update_status_title.setText(_("update_failed_conflict"))
                                            self.update_status_title.setStyleSheet("font-size: 15px; font-weight: bold; color: #e74c3c;")
                                            self.update_all_btn.hide()
                                        else:
                                            self.update_status_title.setText(f"⌛ {status}")
                                    except Exception as e:
                                        print(f"Status Parse Error: {e}")
                            p_reply.deleteLater()
                            
                        p_reply.finished.connect(on_global_poll_fin)

                        # 2. Query the new log route at the same time
                        l_req = QNetworkRequest(QUrl(f"{API_URL}/job/{job_id}/log"))
                        l_reply = self.poll_manager.get(l_req)
                        
                        def on_log_poll_fin():
                            if l_reply.error() == QNetworkReply.NoError:
                                raw_log_bytes = l_reply.readAll().data()
                                if raw_log_bytes:
                                    try:
                                        log_json = json.loads(raw_log_bytes.decode("utf-8").strip())
                                        log_text = log_json.get("log", "")
                                        
                                        if log_text and hasattr(self, "log_console"):
                                            self.log_console.setPlainText(log_text)
                                            # Automatisches Scrollen ans Ende
                                            self.log_console.verticalScrollBar().setValue(
                                                self.log_console.verticalScrollBar().maximum()
                                            )
                                    except Exception as e:
                                        print(f"Log Parse Error: {e}")
                            l_reply.deleteLater()
                            
                        l_reply.finished.connect(on_log_poll_fin)
                        
                        
                    self.global_poll.timeout.connect(poll_global_status)
                    self.global_poll.start(1000)
                    
                except Exception as e:
                    print(f"❌ Exception in POST response handler: {e}")
                    self.load_category()
            else:
                print(f"❌ API Error on POST /job: {reply.errorString()}")
                self.load_category()
                
            reply.deleteLater()
            
        reply.finished.connect(on_global_job_triggered)

    def start_search_timer(self, text):
