class ActivityJobWidget(QFrame):
    job_deleted_signal = Signal()

    def __init__(self, job, network_manager):
        super().__init__()
        self.job_id = job["id"]
        self.network_manager = network_manager
        
        self.setStyleSheet("background-color: #131926; border-radius: 10px; border: 1px solid #232e48;")
        layout = QVBoxLayout(self)
        layout.setContentsMargins(15, 12, 15, 12)

        header_layout = QHBoxLayout()
        
        self.pkg_label = QLabel()
        self.pkg_label.setStyleSheet("font-size: 14px; color: white; border: none;")
        
        self.status_label = QLabel()
        
        self.time_label = QLabel(job.get("created_at", ""))
        self.time_label.setStyleSheet("font-size: 11px; color: #8fa0c4; border: none;")

        header_layout.addWidget(self.pkg_label)
        header_layout.addWidget(self.status_label)
        header_layout.addStretch()
        header_layout.addWidget(self.time_label)

        self.toggle_log_btn = QPushButton(_("show_log"))
        self.toggle_log_btn.setStyleSheet("background: #1f2736; color: white; border-radius: 5px; padding: 5px 10px;")
        self.toggle_log_btn.clicked.connect(self.toggle_log)

        delete_btn = QPushButton(_("delete_job"))
        delete_btn.setStyleSheet("background: #c0392b; color: white; border-radius: 5px; padding: 5px 10px;")
        delete_btn.clicked.connect(self.delete_job)

        header_layout.addWidget(self.toggle_log_btn)
        header_layout.addWidget(delete_btn)
        layout.addLayout(header_layout)

        self.log_edit = QTextEdit()
        self.log_edit.setReadOnly(True)
        self.log_edit.setMinimumHeight(300)
        self.log_edit.setStyleSheet("""
            QTextEdit {
                background: #050811; 
                color: #00f0ff; 
                font-family: monospace; 
                font-size: 11px; 
                border: 1px solid #232e48;
                border-radius: 6px;
                padding: 8px;
            }
        """)
        self.log_edit.hide()
        layout.addWidget(self.log_edit)

        # Erstmalige Daten-Befüllung
        self.update_data(job)

    def update_data(self, job):
        """Aktualisiert Status und Log-Text im laufenden Betrieb."""
        status = job.get("status", "queued").lower()
        
        status_colors = {
            "completed": "#2ecc71",
            "failed": "#e74c3c",
            "interrupted": "#e67e22",
            "running": "#00f0ff",
            "installing": "#00f0ff",
            "removing": "#e74c3c",
            "queued": "#f1c40f"
        }
        color = status_colors.get(status, "#ffffff")

        # Holt die deutsche/englische Übersetzung für den Status
        translated_status = _(f"status_{status}")
        # Fallback, falls ein unbekannter Status auftaucht
        if translated_status.startswith("status_"):
            translated_status = status.upper()

        self.pkg_label.setText(f"<b>{job['package_name']}</b> ({job['action']})")
        
        # Zeigt z. B. "● FEHLGESCHLAGEN" oder "● WIRD INSTALLIERT..." an
        self.status_label.setText(f"● {translated_status.upper()}")
        self.status_label.setStyleSheet(f"font-size: 12px; color: {color}; font-weight: bold; border: none;")

        # Log-Update Logik...
        new_log = job.get("log_output", "")
        if self.log_edit.toPlainText() != new_log:
            self.log_edit.setPlainText(new_log)
            if self.log_edit.isVisible():
                self.log_edit.verticalScrollBar().setValue(
                    self.log_edit.verticalScrollBar().maximum()
                )

    def toggle_log(self):
        if self.log_edit.isVisible():
            self.log_edit.hide()
            self.toggle_log_btn.setText(_("show_log"))
        else:
            self.log_edit.show()
            self.toggle_log_btn.setText(_("hide_log"))
            self.log_edit.verticalScrollBar().setValue(
                self.log_edit.verticalScrollBar().maximum()
            )

    def delete_job(self):
        req = QNetworkRequest(QUrl(f"{API_URL}/job/{self.job_id}"))
        reply = self.network_manager.sendCustomRequest(req, b"DELETE")
        def on_del():
            if reply.error() == QNetworkReply.NoError:
                self.job_deleted_signal.emit()
            reply.deleteLater()
        reply.finished.connect(on_del)

