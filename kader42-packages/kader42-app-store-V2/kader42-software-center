        else: self.load_category()

    def trigger_search(self):
        query = self.search.text().strip()
        cb = int(time.time())
        if not query: return
        
        # Exit the Settings screen while searching
        self.settings_view.hide()
        self.scroll.show()
        
        self.update_header_frame.hide()
        self.banner_label.show()
        self.clear_grid()
        self.sidebar.clearSelection()
        
        url = QUrl(f"{API_URL}/apps?search={query}&cb={cb}")
        self.network_manager.get(QNetworkRequest(url))

    def trigger_all_updates(self):
        job_data = {"package_name": "system-update", "source": "repo", "action": "update"}
        req = QNetworkRequest(QUrl(f"{API_URL}/job"))
        req.setHeader(QNetworkRequest.ContentTypeHeader, "application/json")
        self.network_manager.post(req, json.dumps(job_data).encode("utf-8"))

    def clear_grid(self):
        self.reset_update_banner()
        
        # Sicherheitshalber Spezial-Views verbergen, falls aus der Suche aufgerufen
        if hasattr(self, "activity_view"):
            self.activity_view.hide()
        if hasattr(self, "settings_view"):
            self.settings_view.hide()

        if self.grid_layout is not None:
            while self.grid_layout.count():
                item = self.grid_layout.takeAt(0)
                widget = item.widget()
                if widget is not None:
                    widget.deleteLater()

# ==========================================================
# 3. INTERNATIONAL SINGLE-INSTANCE REVIEW
# ==========================================================
if __name__ == "__main__":
    app = QApplication(sys.argv)
    
    socket_name = "kader42-software-center-single-instance-lock"
    socket = QLocalSocket()
    socket.connectToServer(socket_name)
    
    if socket.waitForConnected(500):
        arguments = sys.argv[1:]
        payload = json.dumps({"arguments": arguments}).encode("utf-8")
        socket.write(payload)
        socket.waitForBytesWritten(1000)
        print("➔ The Kader⁴² Software Center is already running. Arguments passed and process terminated.")
        sys.exit(0)
        
    QLocalServer.removeServer(socket_name)
    local_server = QLocalServer()
    local_server.listen(socket_name)
    
    window = KaderStore()
    
    def on_new_connection():
        client_socket = local_server.nextPendingConnection()
        if client_socket.waitForReadyRead(1000):
            try:
                data = client_socket.readAll().data().decode("utf-8")
                payload = json.loads(data)
                args = payload.get("arguments", [])
                
                if "--view=updates" in args:
                    for i in range(window.sidebar.count()):
                        if window.sidebar.item(i).data(Qt.UserRole) == "kader_updates_view":
                            window.sidebar.setCurrentRow(i)
                            window.load_category()
                            break
            except Exception as e:
                print(f"Error parsing the secondary instance arguments: {e}")
                
        window.showNormal()
        window.activateWindow()
        window.raise_()

    local_server.newConnection.connect(on_new_connection)
    
    window.show()
    sys.exit(app.exec())