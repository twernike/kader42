        card_layout.setContentsMargins(20, 20, 20, 20)
        
        from PySide6.QtWidgets import QCheckBox
        self.auto_cb = QCheckBox(_("setting_auto_update"))
        self.auto_cb.setFont(QFont("Cantarell", 12))
        self.auto_cb.setStyleSheet("QCheckBox { color: white; border: none; } QCheckBox::indicator { width: 18px; height: 18px; }")
        card_layout.addWidget(self.auto_cb)
        
        time_layout = QHBoxLayout()
        time_label = QLabel(_("setting_time"))
        time_label.setStyleSheet("color: #8fa0c4; border: none; font-size: 13px;")
        self.time_edit = QTimeEdit()
        self.time_edit.setDisplayFormat("HH:mm")
        self.time_edit.setFixedWidth(100)
        self.time_edit.setStyleSheet("""
            QTimeEdit { background: #0b0f19; color: white; border: 1px solid #232e48; padding: 5px; border-radius: 6px; }
            QTimeEdit:disabled { background: #1a1f2c; color: #556585; border: 1px solid #1f2736; }
        """)
        time_layout.addWidget(time_label)
        time_layout.addWidget(self.time_edit)
        time_layout.addStretch()
        card_layout.addLayout(time_layout)
        
        self.auto_cb.toggled.connect(self.time_edit.setEnabled)
        self.time_edit.setEnabled(False)
        
        # RETENTION SETTINGS
        ret_comp_layout = QHBoxLayout()
        ret_comp_label = QLabel(_("setting_retention_completed"))
        ret_comp_label.setStyleSheet("color: #8fa0c4; border: none; font-size: 13px;")
        self.ret_comp_spin = QSpinBox()
        self.ret_comp_spin.setRange(1, 30)
        self.ret_comp_spin.setStyleSheet("background: #0b0f19; color: white; border: 1px solid #232e48; padding: 5px; border-radius: 6px;")
        ret_comp_layout.addWidget(ret_comp_label)
        ret_comp_layout.addWidget(self.ret_comp_spin)
        ret_comp_layout.addStretch()
        card_layout.addLayout(ret_comp_layout)

        ret_fail_layout = QHBoxLayout()
        ret_fail_label = QLabel(_("setting_retention_failed"))
        ret_fail_label.setStyleSheet("color: #8fa0c4; border: none; font-size: 13px;")
        self.ret_fail_spin = QSpinBox()
        self.ret_fail_spin.setRange(1, 60)
        self.ret_fail_spin.setStyleSheet("background: #0b0f19; color: white; border: 1px solid #232e48; padding: 5px; border-radius: 6px;")
        ret_fail_layout.addWidget(ret_fail_label)
        ret_fail_layout.addWidget(self.ret_fail_spin)
        ret_fail_layout.addStretch()
        card_layout.addLayout(ret_fail_layout)

        self.save_btn = QPushButton(_("setting_save"))
        self.save_btn.setCursor(Qt.PointingHandCursor)
        self.save_btn.setStyleSheet("""
            QPushButton { background-color: #3daee9; color: white; font-weight: bold; padding: 10px; border-radius: 8px; border: none; font-size: 13px; }
            QPushButton:hover { background-color: #2980b9; }
        """)
        self.save_btn.clicked.connect(self.save_settings)
        card_layout.addWidget(self.save_btn)
        
        self.status_msg = QLabel("")
        self.status_msg.setStyleSheet("color: #2ecc71; font-weight: bold; border: none; font-size: 12px;")
        card_layout.addWidget(self.status_msg)
        
        layout.addWidget(self.card)
        self.load_settings()

    def load_settings(self):
        # Eigener Manager für isolierte Settings-Anfragen
        self.local_manager = QNetworkAccessManager(self)
        req = QNetworkRequest(QUrl(f"{API_URL}/settings"))
        reply = self.local_manager.get(req)
        
        def on_loaded():
            if reply.error() == QNetworkReply.NoError:
                raw_bytes = reply.readAll().data()
                if raw_bytes and len(raw_bytes) > 0:
                    try:
                        data = json.loads(raw_bytes.decode("utf-8").strip())
                        is_active = data.get("auto_updates", False)
                        self.auto_cb.setChecked(is_active)
                        self.time_edit.setEnabled(is_active)
                        
                        t_str = data.get("update_time", "04:00")
                        h, m = map(int, t_str.split(":"))
                        self.time_edit.setTime(QTime(h, m))
                        
                        self.ret_comp_spin.setValue(data.get("retention_completed_days", 1))
                        self.ret_fail_spin.setValue(data.get("retention_failed_days", 3))
                    except Exception as e:
                        print(f"Error parsing settings: {e}")
            reply.deleteLater()
            
        reply.finished.connect(on_loaded)


    def save_settings(self):
        payload_data = {
            "auto_updates": self.auto_cb.isChecked(),
            "update_time": self.time_edit.time().toString("HH:mm"),
            "retention_completed_days": self.ret_comp_spin.value(),
            "retention_failed_days": self.ret_fail_spin.value()
        }
        req = QNetworkRequest(QUrl(f"{API_URL}/settings"))
        req.setHeader(QNetworkRequest.ContentTypeHeader, "application/json")
        payload = json.dumps(payload_data).encode("utf-8")
        
        reply = self.network_manager.post(req, payload)
        def on_saved():
            if reply.error() == QNetworkReply.NoError:
                self.status_msg.setText(_("setting_success"))
                QTimer.singleShot(3000, lambda: self.status_msg.setText(""))
            reply.deleteLater()
        reply.finished.connect(on_saved)

