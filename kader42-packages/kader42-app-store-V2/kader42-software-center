            if reply.error() == QNetworkReply.NoError:
                raw_bytes = reply.readAll().data()
                if raw_bytes and len(raw_bytes) > 0:
                    try:
                        json_str = raw_bytes.decode("utf-8").strip()
                        if json_str and json_str not in ["", "null"]:
                            data = json.loads(json_str)
                            if data.get("update_available", False):
                                self.show_self_update_dialog()
                    except Exception as e:
                        print(f"Self-update parse error: {e}")
            reply.deleteLater()
            
        reply.finished.connect(on_check)

