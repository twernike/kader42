class ActivityView(QWidget):
    def __init__(self, network_manager, parent=None):
        super().__init__(parent)
        self.network_manager = network_manager
        
        layout = QVBoxLayout(self)
        layout.setAlignment(Qt.AlignTop)
        layout.setSpacing(15)
        layout.setContentsMargins(30, 30, 30, 30)

        title = QLabel(_("menu_activity"))
        title.setFont(QFont("Cantarell", 18, QFont.Weight.Bold))
        title.setStyleSheet("color: #00f0ff;")
        layout.addWidget(title)

        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        self.scroll.setStyleSheet("border: none; background: transparent;")

        self.container = QWidget()
        self.list_layout = QVBoxLayout(self.container)
        self.list_layout.setAlignment(Qt.AlignTop)
        self.list_layout.setSpacing(10)
        self.scroll.setWidget(self.container)

        layout.addWidget(self.scroll)

        # Polling-Timer für automatische Updates initialisieren
        self.poll_timer = QTimer(self)
        self.poll_timer.setInterval(1500)  # Alle 1,5 Sekunden aktualisieren
        self.poll_timer.timeout.connect(self.load_activity)

    def showEvent(self, event):
        """Wird von Qt automatisch aufgerufen, wenn das Widget sichtbar wird."""
        super().showEvent(event)
        self.load_activity()
        if not self.poll_timer.isActive():
            self.poll_timer.start()

    def hideEvent(self, event):
        """Wird aufgerufen, wenn der Nutzer die Ansicht verlässt (spart CPU & Netzwerk)."""
        super().hideEvent(event)
        if self.poll_timer.isActive():
            self.poll_timer.stop()

    def load_activity(self):
        req = QNetworkRequest(QUrl(f"{API_URL}/jobs"))
        reply = self.network_manager.get(req)

        def on_loaded():
            if reply.error() == QNetworkReply.NoError:
                raw_bytes = reply.readAll().data()
                if raw_bytes:
                    try:
                        raw_str = raw_bytes.decode("utf-8").strip()
                        jobs = json.loads(raw_str) if raw_str else []
                        
                        if not jobs:
                            # Liste leeren und "Keine Jobs" anzeigen
                            self.clear_list_layout()
                            lbl = QLabel(_("no_jobs"))
                            lbl.setStyleSheet("color: #8fa0c4; font-size: 14px; padding: 10px;")
                            self.list_layout.addWidget(lbl)
                        else:
                            self.update_or_render_jobs(jobs)
                    except Exception as e:
                        print(f"Error loading activity jobs: {e}")
            reply.deleteLater()

        reply.finished.connect(on_loaded)

    def clear_list_layout(self):
        while self.list_layout.count():
            item = self.list_layout.takeAt(0)
            if item.widget():
                item.widget().deleteLater()

    def update_or_render_jobs(self, jobs):
        """Aktualisiert bestehende Widgets ohne Neuzeichnen (verhindert Flackern)."""
        existing_widgets = {}
        for i in range(self.list_layout.count()):
            w = self.list_layout.itemAt(i).widget()
            if isinstance(w, ActivityJobWidget):
                existing_widgets[w.job_id] = w

        # Wenn sich die Anzahl oder Reihenfolge der Jobs geändert hat: Komplett neu aufbauen
        job_ids = [j["id"] for j in jobs]
        if set(existing_widgets.keys()) != set(job_ids):
            self.clear_list_layout()
            for job in jobs:
                w = ActivityJobWidget(job, self.network_manager)
                w.job_deleted_signal.connect(self.load_activity)
                self.list_layout.addWidget(w)
        else:
            # Nur die Daten in den bestehenden Karten aktualisieren
            for job in jobs:
                widget = existing_widgets.get(job["id"])
                if widget:
                    widget.update_data(job)

