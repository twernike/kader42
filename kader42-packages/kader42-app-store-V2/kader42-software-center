        banner_path = "/usr/share/kader42/software-center-banner.png"
        if os.path.exists(banner_path):
            self.banner_label.setPixmap(QPixmap(banner_path))
            self.banner_label.setStyleSheet("QLabel { background: transparent; border: none; }")
        else:
            self.banner_label.setText("<h2>Kader⁴² Software Center</h2>")
            self.banner_label.setAlignment(Qt.AlignCenter)
            self.banner_label.setStyleSheet("QLabel { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1a233a, stop:1 #131926); border: 1px solid #232e48; border-radius: 14px; color: white; }")
      
        right_layout.addWidget(self.banner_label, 0, Qt.AlignCenter)
        
        # Scroll area for the grid
        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        self.scroll.setStyleSheet("border: none; background: transparent;")
        
        QScroller.grabGesture(self.scroll.viewport(), QScroller.TouchGesture)
        scroller = QScroller.scroller(self.scroll.viewport())
        scroller_properties = scroller.scrollerProperties()
        scroller_properties.setScrollMetric(QScrollerProperties.MousePressEventDelay, 0.0)
        scroller.setScrollerProperties(scroller_properties)

        self.grid_widget = QWidget()
        self.grid_layout = QGridLayout(self.grid_widget)
        self.grid_layout.setAlignment(Qt.AlignTop | Qt.AlignLeft)
        self.grid_layout.setSpacing(22)
        self.scroll.setWidget(self.grid_widget)
        
        # NEU: Settings View als persistente Schicht registrieren
        self.settings_view = SettingsView(self.network_manager)
        self.settings_view.hide()
        
        right_layout.addWidget(self.scroll)
        right_layout.addWidget(self.settings_view) # Wird flexibel ein-/ausgeblendet
        content.addLayout(right_layout)
        self.root.addLayout(content)
        
        self.search_timer = QTimer()
        self.search_timer.setSingleShot(True)
        self.search_timer.timeout.connect(self.trigger_search)

        self.start_view = "default"
        if len(sys.argv) > 1 and sys.argv[1] == "--view=updates":
            self.start_view = "updates"

        self.fetch_data()

    def fetch_data(self):
        url = QUrl(f"{API_URL}/categories")
        self.network_manager.get(QNetworkRequest(url))

    def on_json_loaded(self, reply):
        if reply.error() == QNetworkReply.NoError:
            try:
                raw_data = reply.readAll().data().decode()
                if not raw_data: return
                    
                data = json.loads(raw_data)
                path = reply.url().path()
                
                if path == "/categories":
                    self.apps_data = {"categories": data}
                    self.setup_sidebar()
                elif path in ["/apps", "/installed", "/updates"]:
                    self.clear_grid()
                     
                    if path == "/updates":
                        total_updates = data.get("total_updates", 0)
                        packages = data.get("packages", [])
                        
                        if total_updates > 0:
                            self.update_status_title.setText(_("updates_available_title") % total_updates)
                            self.update_all_btn.show()
                            self.update_all_btn.setEnabled(True)
                        else:
                            self.update_status_title.setText(_("system_up_to_date"))
                            self.update_all_btn.hide()
                        
                        self.render_category_apps(packages)
                    else:
                        self.render_category_apps(data)
                    
            except Exception as e:
                print(f"❌ JSON Parse Fehler in GUI: {e}")
        else:
            print(f"❌ Netzwerkfehler in der GUI: {reply.errorString()}")
        reply.deleteLater()

    def setup_sidebar(self):
        self.sidebar.clear()
        
        installed_icon = QIcon.fromTheme("emblem-success-symbolic", QIcon.fromTheme("software-installed-panel"))
        installed_item = QListWidgetItem(installed_icon, _("status_installed"))
        installed_item.setData(Qt.UserRole, "kader_installed_view")
        self.sidebar.addItem(installed_item)
        
        updates_icon = QIcon.fromTheme("update-medium", QIcon.fromTheme("go-up"))
        self.updates_item = QListWidgetItem(updates_icon, _("menu_updates"))
        self.updates_item.setData(Qt.UserRole, "kader_updates_view")
        self.sidebar.addItem(self.updates_item)
        
        cats = self.apps_data.get("categories", [])
        for c in cats:
            name = c.get(SYSTEM_LANG, c.get("de", "Apps"))
            icon_name = c.get("icon", "package-x-generic")
            icon = QIcon.fromTheme(icon_name, QIcon.fromTheme("package-x-generic"))
            
            item = QListWidgetItem(icon, name)
            item.setData(Qt.UserRole, c["id"])
            self.sidebar.addItem(item)
            
        # NEU: Settings Item ganz unten anfügen
        settings_icon = QIcon.fromTheme("preferences-system", QIcon.fromTheme("settings-configure"))
        settings_item = QListWidgetItem(settings_icon, _("menu_settings"))
        settings_item.setData(Qt.UserRole, "kader_settings_view")
        self.sidebar.addItem(settings_item)
            
        if self.start_view == "updates":
            for i in range(self.sidebar.count()):
                if self.sidebar.item(i).data(Qt.UserRole) == "kader_updates_view":
                    self.sidebar.setCurrentRow(i)
                    self.start_view = "default"
                    break
        elif self.sidebar.count() > 0: 
            self.sidebar.setCurrentRow(0)
            
        self.load_category()
        self.fetch_sidebar_badge_count()

    def fetch_sidebar_badge_count(self):
        self.badge_manager = QNetworkAccessManager(self)
        def on_badge_loaded(reply):
            if reply.error() == QNetworkReply.NoError:
                try:
                    data = json.loads(reply.readAll().data().decode())
                    total = data.get("total_updates", 0)
                    if total > 0:
                        self.updates_item.setText(f"{_('menu_updates')} ({total})")
                    else:
                        self.updates_item.setText(_("menu_updates"))
                except: pass
            reply.deleteLater()
        self.badge_manager.finished.connect(on_badge_loaded)
        self.badge_manager.get(QNetworkRequest(QUrl(f"{API_URL}/updates")))

    def on_sidebar_clicked(self, item):
        self.search.blockSignals(True)
        self.search.clear() 
        self.search.blockSignals(False)
        self.load_category()

    def load_category(self):
        self.clear_grid()
        cur = self.sidebar.currentItem()
        cb = int(time.time())
        if not cur: return
        
        cat_id = cur.data(Qt.UserRole)
        
        # UI-Umschaltung für das Einstellungs-Widget abfangen
        if cat_id == "kader_settings_view":
            self.scroll.hide()
            self.banner_label.hide()
            self.update_header_frame.hide()
            self.settings_view.show()
            self.settings_view.load_settings() # Live die API abfragen
            return
            
        # Standard-Ansicht wiederherstellen, falls Settings aktiv waren
        self.settings_view.hide()
        self.scroll.show()
        
        if cat_id == "kader_updates_view":
            self.banner_label.hide()
            self.update_header_frame.show()
            self.update_status_title.setText(_("status_checking"))
            self.update_all_btn.hide()
            url = QUrl(f"{API_URL}/updates?cb={cb}")
            self.network_manager.get(QNetworkRequest(url))
        else:
            self.update_header_frame.hide()
            self.banner_label.show()
            
            if cat_id == "kader_installed_view":
                url = QUrl(f"{API_URL}/installed?cb={cb}")
                self.network_manager.get(QNetworkRequest(url))
            else:
                url = QUrl(f"{API_URL}/apps?category={cat_id}&cb={cb}")
                self.network_manager.get(QNetworkRequest(url))
    
    def refresh_current_view(self):
        print("➔ GUI: Job completed! Starting automatic refresh...")
        self.fetch_sidebar_badge_count()
        current_item = self.sidebar.currentItem()
        if current_item:
            self.load_category()
        else:
            query = self.search.text().strip()
            if query:
                self.trigger_search()

    def render_category_apps(self, apps):
        columns = 3
        for index, a in enumerate(apps):
            pkg_lower = a['package_name'].lower()
            
            # NEU: Das eigene Software Center wird komplett aus allen Ansichten gefiltert 
            if pkg_lower == "kader42-software-center":
                continue
                
            row = index // columns
            col = index % columns
            
            flat_id = None
            if "firefox" in pkg_lower: flat_id = "org.mozilla.firefox"
            elif "vlc" in pkg_lower: flat_id = "org.videolan.VLC"
            
            desc_key = a.get('description', '')
            source_upper = a.get('source', '').upper()
            
            if desc_key == "desc_update_available":
                final_description = _("desc_update_available") % source_upper
            elif desc_key == "desc_installed_repo":
                final_description = _("desc_installed_repo")
            elif desc_key == "desc_installed_aur":
                final_description = _("desc_installed_aur")
            elif desc_key == "desc_generic_system":
                final_description = _("desc_generic_system") % source_upper
            elif desc_key.startswith("desc_core_"):
                final_description = _(desc_key)
            else:
                final_description = desc_key

            card = AppCard(
                a['name'], 
                final_description, 
                a['package_name'], 
                icon_name="package-x-generic",
                source=a['source'],
                flatpak_id=flat_id,
                status=a['status']
            )

            card.job_completed_signal.connect(
                lambda: QTimer.singleShot(400, self.refresh_current_view)
            )

            self.grid_layout.addWidget(card, row, col)

    def trigger_all_updates(self):
        print("📡 Sende POST für globales System-Update...")
        self.update_all_btn.setEnabled(False)
        self.update_status_title.setText(_("status_queue"))
        
        req = QNetworkRequest(QUrl(f"{API_URL}/job"))
        req.setHeader(QNetworkRequest.ContentTypeHeader, "application/json")
        job_data = {"package_name": "system-update", "source": "repo", "action": "update"}
        payload = json.dumps(job_data).encode("utf-8")
        
        reply = self.network_manager.post(req, payload)
        def on_global_job_triggered():
            if reply.error() == QNetworkReply.NoError:
                try:
                    res = json.loads(reply.readAll().data().decode())
                    job_id = res.get("id")
                    self.global_poll = QTimer(self)
                    def poll_global_status():
                        p_req = QNetworkRequest(QUrl(f"{API_URL}/job/{job_id}"))
                        p_reply = self.network_manager.get(p_req)
                        def on_global_poll_fin():
                            if p_reply.error() == QNetworkReply.NoError:
                                j_data = json.loads(p_reply.readAll().data().decode())
                                status = j_data.get("status")
                                if status == "completed":
                                    self.global_poll.stop()
                                    self.refresh_current_view()
                                elif status == "failed":
                                    self.global_poll.stop()
                                    self.load_category()
                                else:
                                    self.update_status_title.setText(f"⌛ {status}")
                            p_reply.deleteLater()
                        p_reply.finished.connect(on_global_poll_fin)
                    self.global_poll.timeout.connect(poll_global_status)
                    self.global_poll.start(1000)
                except:
                    self.load_category()
            else:
                self.load_category()
            reply.deleteLater()
        reply.finished.connect(on_global_job_triggered)

    def start_search_timer(self, text):
        if text.strip(): self.search_timer.start(400)
        else: self.load_category()

    def trigger_search(self):
        query = self.search.text().strip()
        cb = int(time.time())
        if not query: return
        
        # Beim Suchen aus den Settings herausspringen
        self.settings_view.hide()
        self.scroll.show()
        
        self.update_header_frame.hide()
        self.banner_label.show()
        self.clear_grid()
        self.sidebar.clearSelection()
        
        url = QUrl(f"{API_URL}/apps?search={query}&cb={cb}")
        self.network_manager.get(QNetworkRequest(url))

    def clear_grid(self):
        if self.grid_layout is not None:
            while self.grid_layout.count():
                item = self.grid_layout.takeAt(0)
                widget = item.widget()
                if widget is not None:
                    widget.deleteLater()

