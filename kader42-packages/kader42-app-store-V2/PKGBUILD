# Maintainer: Thomas Wernike <support@kader42.de>
pkgname=kader42-software-center
pkgver=1.0.2
pkgrel=0
pkgdesc="Software Management for Kader⁴²"
arch=('any')
url="https://kader42.de"
license=('GPL')
depends=(
    'python' 
    'pyside6' 
    'yay' 
    'pyalpm'      
    'qt6-tools'   
    'kconfig'     
)
provides=('pamac-aur' 'pamac-tray-icon-plasma' 'pamac' 'pamac-manager')
conflicts=('pamac-aur' 'pamac-tray-icon-plasma' 'pamac' 'pamac-manager')

source=('kader42-software-center-api.py'
        'shared.py'
        'kader42-software-center-worker.py'
        'kader42-software-center-api.service'
        'kader42-software-center-worker.service'
        'kader42-autoupdate.service'
        'kader42-autoupdate.timer'
        'kader42-software-center'
        'kader42-software-center.desktop'
        '42-kader-store.rules'
        'kader42-software-center-tray.py'
        'kader42-software-center-tray.desktop'
        'software-center-tray-icon.svg'
        'kader42-check-and-update.py'
        )
md5sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP') 

package() {
  install -Dm755 "${srcdir}/kader42-software-center-api.py" "${pkgdir}/usr/lib/kader42-software-center/kader42-software-center-api.py"
  install -Dm755 "${srcdir}/shared.py" "${pkgdir}/usr/lib/kader42-software-center/shared.py"
  install -Dm755 "${srcdir}/kader42-software-center-worker.py" "${pkgdir}/usr/lib/kader42-software-center/kader42-software-center-worker.py"
  install -Dm755 "${srcdir}/kader42-software-center-tray.py" "${pkgdir}/usr/lib/kader42-software-center/kader42-software-center-tray.py"
  install -Dm755 "${srcdir}/kader42-check-and-update.py" "${pkgdir}/usr/lib/kader42-software-center/kader42-check-and-update.py"


  install -Dm755 "${srcdir}/kader42-software-center" "${pkgdir}/usr/bin/kader42-software-center"
  install -Dm755 "${srcdir}/kader42-software-center.desktop" "${pkgdir}/usr/share/applications/kader42-software-center.desktop"

  install -Dm644 "${srcdir}/software-center-tray-icon.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/software-center-tray-icon.svg"
  

  install -Dm644 "${srcdir}/42-kader-store.rules" "${pkgdir}/usr/share/polkit-1/rules.d/42-kader-store.rules"

  install -Dm644 "${srcdir}/kader42-software-center-api.service" "${pkgdir}/usr/lib/systemd/user/kader42-software-center-api.service"
  install -Dm644 "${srcdir}/kader42-software-center-worker.service" "${pkgdir}/usr/lib/systemd/user/kader42-software-center-worker.service"
  install -Dm644 "${srcdir}/kader42-autoupdate.service" "${pkgdir}/usr/lib/systemd/system/kader42-autoupdate.service"
  install -Dm644 "${srcdir}/kader42-autoupdate.timer" "${pkgdir}/usr/lib/systemd/system/kader42-autoupdate.timer"


  install -Dm755 "${srcdir}/kader42-software-center-tray.desktop" "${pkgdir}/etc/xdg/autostart/kader42-software-center-tray.desktop"

  mkdir -p "${pkgdir}/usr/lib/systemd/user/default.target.wants"
  ln -sf "../kader42-software-center-api.service" "${pkgdir}/usr/lib/systemd/user/default.target.wants/kader42-software-center-api.service"
  ln -sf "../kader42-software-center-worker.service" "${pkgdir}/usr/lib/systemd/user/default.target.wants/kader42-software-center-worker.service"
}