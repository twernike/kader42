# /usr/lib/initcpio/install/kader42-rollback

build() {
    # Provide the necessary binaries for dynamic reading and copying
    add_binary awk
    add_binary cp
    add_binary rm
    add_binary cut
    add_binary blkid
    
    # Register the runtime script
    add_runscript
}

help() {
    cat <<HELPEOF
Kader42 Offline Rollback Hook: Intercepts failed core updates
during the boot process and restores the kernel and modules.
HELPEOF
}