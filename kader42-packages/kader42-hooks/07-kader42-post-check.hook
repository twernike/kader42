[Trigger]
Operation = Upgrade
Type = Package
Target = linux
Target = linux-firmware
Target = intel-ucode
Target = amd-ucode
Target = glibc
Target = systemd
Target = mkinitcpio

[Action]
Description = Kader42: Überprüfe Integrität des Updates...
When = PostTransaction
Exec = /usr/share/kader42/kader42-post-check.sh