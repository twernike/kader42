[Trigger]
Operation = Upgrade
Operation = Install
Type = Package
# Here is a list of the system's lifelines:
Target = linux
Target = linux-firmware
Target = intel-ucode
Target = amd-ucode
Target = glibc
Target = systemd
Target = mkinitcpio

[Action]
Description = Kader42: Critical system components are being updated. Create a backup...
When = PreTransaction
Exec = /usr/share/kader42/kader42-kernel-backup.sh