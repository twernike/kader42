# /usr/lib/initcpio/hooks/kader42-rollback

run_latehook() {
    # 1. Dynamically find the EFI partition via universal GPT label (fstab-independent!)
    local EFI_DEV
    EFI_DEV=$(blkid -t PARTLABEL="EFI System Partition" -o device | head -n 1)

    # Fallback for alternative partition labels
    if [ -z "$EFI_DEV" ]; then
        EFI_DEV=$(blkid -o device | grep -E "nvme[0-9]n1p1|sd[a-z]1" | head -n 1)
    fi

    if [ -z "$EFI_DEV" ]; then
        echo ":: [Kader⁴² Rollback]: No EFI System Partition found automatically."
        return 0
    fi

    # 2. Mount the EFI partition temporarily (Directly rw to avoid remount issues)
    mkdir -p /tmp/boot
    if ! mount -o rw "$EFI_DEV" /tmp/boot 2>/dev/null; then
        echo ":: [Kader⁴² Rollback]: Failed to mount EFI partition ($EFI_DEV)."
        return 0
    fi

    # 3. Check whether the rollback flag exists
    if [ -f /tmp/boot/kader42-rollback.trigger ]; then
        echo ":::::::::::::::::::::::::::::::::::::::::::::::::::::::::"
        echo ":: KADER⁴² Rollback: Failed update detected!           ::"
        echo ":: Start automatic offline rollback...                 ::"
        echo ":::::::::::::::::::::::::::::::::::::::::::::::::::::::::"

        # Determine the current backup version based on the booted kernel
        RUNNING_VER=$(uname -r)
        BACKUP_PATH="/tmp/boot/kader42-backups/${RUNNING_VER}"

        if [ -d "$BACKUP_PATH" ]; then
            echo "-> Restore kernel modules to /new_root/usr/lib/modules/${RUNNING_VER}..."
            mkdir -p "/new_root/usr/lib/modules/${RUNNING_VER}"
            cp -a "$BACKUP_PATH/modules/${RUNNING_VER}/"* "/new_root/usr/lib/modules/${RUNNING_VER}/"

            echo "-> Clean up corrupted boot files..."
            cp -a "$BACKUP_PATH/vmlinuz-linux-${RUNNING_VER}" /tmp/boot/vmlinuz-linux
            cp -a "$BACKUP_PATH/initramfs-linux-${RUNNING_VER}" /tmp/boot/initramfs-linux.img

            echo "$(date): Rollback for version ${RUNNING_VER} completed successfully." >> /tmp/boot/kader42-backup-history.log
            
            # Clear the flag to prevent boot loops
            rm -f /tmp/boot/kader42-rollback.trigger
            echo "✅ Rollback complete! The system is now booting normally."
            sleep 3
        else
            echo "❌ ERROR: No matching backup directory found at ${BACKUP_PATH}!"
            sleep 5
        fi
    fi

    # 4. GUARANTEED UNMOUNT: This MUST be outside the if-block to prevent ghost mounts!
    umount /tmp/boot 2>/dev/null
    rmdir /tmp/boot 2>/dev/null
}