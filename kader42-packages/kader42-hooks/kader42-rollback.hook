#!/bin/sh
# /usr/lib/initcpio/hooks/kader42-rollback

run_hook() {
    echo ":: [Kader42-Rollback] Check the status of the latest system update..."

    # In the initramfs, your hard drive's root partition is mounted at /new_root.
    # We first look for the EFI partition to check for the rollback trigger.
    local efi_dev
    efi_dev=$(blkid -t TYPE=vfat -o device | grep -E "nvme|sd" | head -n 1)

    if [ -n "$efi_dev" ]; then
        # Create a temporary mount point on the RAM disk
        mkdir -p /tmp_efi
        
        # For now, just attach it in read-only mode (ro) to look for the trigger
        if mount -t vfat -o ro "$efi_dev" /tmp_efi 2>/dev/null; then
            
            # # Did the Pacman post-hook leave behind the trigger file?
            if [ -f "/tmp_efi/kader42-rollback.trigger" ]; then
                echo "===================================================="
                echo “⚠️  [Kader42-Rollback] FAILED UPDATE DETECTED!”
                echo “:: Starting automatic offline rollback...”
                echo "===================================================="
                
                # Switch the partition to read-write (rw) mode for repair
                mount -o remount,rw /tmp_efi
                
                # --------------------------------------------------
                # 1. REPLACE KERNEL BINARIES ON THE EFI PARTITION
                # --------------------------------------------------
                echo ":: Wiederherstellung der Haupt-Bootdateien..."
                cp /tmp_efi/kader42-fallback/vmlinuz-linux /tmp_efi/vmlinuz-linux
                cp /tmp_efi/kader42-fallback/initramfs-linux.img /tmp_efi/initramfs-linux.img
                
                if [ -f /tmp_efi/kader42-fallback/intel-ucode.img ]; then
                    cp /tmp_efi/kader42-fallback/intel-ucode.img /tmp_efi/intel-ucode.img
                fi
                if [ -f /tmp_efi/kader42-fallback/amd-ucode.img ]; then
                    cp /tmp_efi/kader42-fallback/amd-ucode.img /tmp_efi/amd-ucode.img
                fi
                
                # --------------------------------------------------
                # 2. RESTORE KERNEL MODULES IN /new_root
                # --------------------------------------------------
                echo ":: Wiederherstellung der Kernel-Module..."
                
                # We iterate through the backup module directory. 
                # ${mod_dir##*/} extracts the folder name (the kernel version) without the path.
                for mod_dir in /tmp_efi/kader42-fallback/modules/*; do
                    if [ -d "$mod_dir" ]; then
                        local version="${mod_dir##*/}"
                        echo "   -> Stelle Module für Version [ $version ] wieder her..."
                        
                        # Create the destination folder in the actual system and copy the modules
                        mkdir -p "/new_root/usr/lib/modules/$version"
                        cp -a "$mod_dir/." "/new_root/usr/lib/modules/$version/"
                    fi
                done
                
                # --------------------------------------------------
                # 3. DELETE TRIGGER (Important to prevent infinite loops!)
                # --------------------------------------------------
                rm -f /tmp_efi/kader42-rollback.trigger
                
                echo "----------------------------------------------------"
                echo “✅ [Kader42-Rollback] Rollback successful!”
                echo “:: The system will now boot safely using the stable version.”
                echo "===================================================="
            fi
            
            # Safely unmount the EFI partition
            umount /tmp_efi
        fi
    fi
}