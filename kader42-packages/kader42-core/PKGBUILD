# Maintainer: Thomas Wernike <support@kader42.de>
pkgname=kader42-core
pkgver=1.0.12
pkgrel=7
pkgdesc="Core configurations and systemd units for Kader42"
arch=('any')
depends=('bash' 'dbus' 'kernel-modules-hook' 'pacback' 'systemd-boot-pacman-hook' 'system-config-printer' 'cups' 'libreoffice-fresh-de' 'kader42-software-center')
install=kader42-core.install

source=(
    'kader42-cleanup.service'
    'kader42-software-center-favorite.upd'
    'kader42-software-center-favorite.js'
)

sha256sums=(
    'SKIP'
    'SKIP'
    'SKIP'
)

conflicts=('kader42-hooks')
replaces=('kader42-hooks')

package() {
    install -Dm644 "${startdir}/etc/bluetooth/main.conf.d/61-kader42.conf" "${pkgdir}/etc/bluetooth/main.conf.d/61-kader42.conf"
    install -Dm644 "${startdir}/etc/firefox/mozilla.cfg" "${pkgdir}/etc/firefox/mozilla.cfg"
    install -Dm644 "${startdir}/etc/firefox/syspref.js" "${pkgdir}/etc/firefox/syspref.js"
    install -Dm644 "${startdir}/etc/modprobe.d/kader42-framework-fixes.conf" "${pkgdir}/etc/modprobe.d/kader42-framework-fixes.conf"
    install -Dm755 "${startdir}/etc/NetworkManager/conf.d/10-kader42-globally-managed.conf" "${pkgdir}/etc/NetworkManager/conf.d/10-kader42-globally-managed.conf"
    install -Dm644 "${startdir}/etc/NetworkManager/system-connections/20-kader42-wired-default.nmconnection" "${pkgdir}/etc/NetworkManager/system-connections/20-kader42-wired-default.nmconnection"
    install -Dm755 "${startdir}/etc/profile.d/kader42-libreoffice-gtk-fix.sh" "${pkgdir}/etc/profile.d/kader42-libreoffice-gtk-fix.sh"
    install -Dm644 "${startdir}/etc/sddm.conf.d/61-kader42-login.conf" "${pkgdir}/etc/sddm.conf.d/61-kader42-login.conf"
    install -Dm644 "${startdir}/etc/systemd/iio-sensor-proxy.d/61-kader42-override.conf" "${pkgdir}/etc/systemd/iio-sensor-proxy.d/61-kader42-override.conf"
    install -Dm644 "${startdir}/etc/systemd/logind.conf.d/61-kader42-live.conf" "${pkgdir}/etc/systemd/logind.conf.d/61-kader42-live.conf"
    install -Dm644 "${startdir}/etc/systemd/system/io-sensor-proxy.service.d/61-kader42-order.conf" "${pkgdir}/etc/systemd/system/io-sensor-proxy.service.d/61-kader42-order.conf"
    install -Dm644 "${startdir}/etc/udev/hwdb.d/60-kader42-sensor-dell-latitude.hwdb" "${pkgdir}/etc/udev/hwdb.d/60-kader42-sensor-dell-latitude.hwdb"
    install -Dm644 "${startdir}/etc/udev/hwdb.d/61-kader42-framework.hwdb" "${pkgdir}/etc/udev/hwdb.d/61-kader42-framework.hwdb"
    install -Dm755 "${startdir}/etc/xdg/autostart/kader42-hello.desktop" "${pkgdir}/etc/xdg/autostart/kader42-hello.desktop"
    install -Dm755 "${startdir}/etc/xdg/kdeglobals" "${pkgdir}/etc/xdg/kdeglobals"
    install -Dm755 "${startdir}/etc/xdg/kickerrc" "${pkgdir}/etc/xdg/kickerrc"
    install -Dm755 "${startdir}/etc/xdg/konsolerc" "${pkgdir}/etc/xdg/konsolerc"
    install -Dm755 "${startdir}/etc/xdg/ksplashrc" "${pkgdir}/etc/xdg/ksplashrc"
    install -Dm755 "${startdir}/etc/xdg/kwinrc" "${pkgdir}/etc/xdg/kwinrc"
    install -Dm755 "${startdir}/etc/xdg/plasmarc" "${pkgdir}/etc/xdg/plasmarc"
    install -Dm755 "${startdir}/etc/xdg/plasmashellrc" "${pkgdir}/etc/xdg/plasmashellrc"
    install -Dm755 "${startdir}/etc/xdg/powerdevilrc" "${pkgdir}/etc/xdg/powerdevilrc"
    install -Dm755 "${startdir}/etc/xdg/powermanagementprofilesrc" "${pkgdir}/etc/xdg/powermanagementprofilesrc"
    install -Dm755 "${startdir}/usr/bin/kader42-discover-sync" "${pkgdir}/usr/bin/kader42-discover-sync"
    install -Dm755 "${startdir}/usr/bin/kader42-hello" "${pkgdir}/usr/bin/kader42-hello"
    install -Dm755 "${startdir}/usr/bin/kader-install.sh" "${pkgdir}/usr/bin/kader-install.sh"
    install -Dm644 "${startdir}/usr/lib/systemd/system/display-manager.service.d/kader42-plymouth.conf" "${pkgdir}/usr/lib/systemd/system/display-manager.service.d/kader42-plymouth.conf"
    install -Dm755 "${startdir}/usr/lib/systemd/system-preset/61-kader-2.preset" "${pkgdir}/usr/lib/systemd/system-preset/61-kader-2.preset"
    install -Dm644 "${startdir}/usr/lib/systemd/system/sddm.service.d/42-kader42-override.conf" "${pkgdir}/usr/lib/systemd/system/sddm.service.d/42-kader42-override.conf"
    install -Dm644 "${startdir}/usr/lib/systemd/system/sddm.service.d/42-kader42-plymouth.conf" "${pkgdir}/usr/lib/systemd/system/sddm.service.d/42-kader42-plymouth.conf"
    install -Dm644 "${startdir}/usr/lib/systemd/user-preset/62-kader-user-2.preset" "${pkgdir}/usr/lib/systemd/user-preset/62-kader-user-2.preset"
    install -Dm755 "${startdir}/usr/lib/vconsole.conf" "${pkgdir}/usr/lib/vconsole.conf"
    install -Dm644 "${startdir}/usr/share/konsole/kader42-2.colorscheme" "${pkgdir}/usr/share/konsole/kader42-2.colorscheme"
    install -Dm644 "${startdir}/usr/share/konsole/Kader42-2.profile" "${pkgdir}/usr/share/konsole/Kader42-2.profile"
    install -Dm644 "${startdir}/usr/share/pixmaps/mello.svg" "${pkgdir}/usr/share/pixmaps/mello.svg"
    install -Dm644 "${startdir}/usr/share/pixmaps/mello_with_tablet.png" "${pkgdir}/usr/share/pixmaps/mello_with_tablet.png"
    install -Dm644 "${startdir}/usr/share/sddm/themes/kader42/login-screen.png" "${pkgdir}/usr/share/sddm/themes/kader42/login-screen.png"
    install -Dm644 "${startdir}/usr/share/sddm/themes/kader42/theme.conf.user" "${pkgdir}/usr/share/sddm/themes/kader42/theme.conf.user"

    # Spezielle Services & KConf-Symlinks
    install -Dm644 "${srcdir}/kader42-cleanup.service" "${pkgdir}/usr/lib/systemd/system/kader42-cleanup.service"
    mkdir -p "${pkgdir}/usr/lib/systemd/system/multi-user.target.wants"
    ln -sf "../kader42-cleanup.service" "${pkgdir}/usr/lib/systemd/system/multi-user.target.wants/kader42-cleanup.service"

    install -Dm644 "${srcdir}/kader42-software-center-favorite.upd" "${pkgdir}/usr/share/kconf_update/kader42-software-center-favorite.upd"
    install -Dm755 "${srcdir}/kader42-software-center-favorite.js" "${pkgdir}/usr/share/kconf_update/kader42-software-center-favorite.js"
}
