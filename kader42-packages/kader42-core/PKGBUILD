# Maintainer: Thomas Wernike <support@kader42.de>
pkgname=kader42-core
pkgver=1.0.2
pkgrel=3
pkgdesc="Core configurations and systemd units for Kader42"
arch=('any')
depends=('bash' 'dbus' 'kader42-hooks')
install=kader42-core.install
source=('kader42-cleanup.service')

md5sums=('SKIP')


package() {
    local tmp_overlay="${pkgdir}/usr/share/kader42/core-overlay"
    local perm_overrides="${pkgdir}/usr/share/kader42/upstream-overrides"
    
    mkdir -p "$tmp_overlay" "$perm_overrides"

    # 1. Copy your repository to the temporary folder
    if [ -d "${startdir}/etc" ]; then cp -R "${startdir}/etc" "$tmp_overlay/"; fi
    if [ -d "${startdir}/usr" ]; then cp -R "${startdir}/usr" "$tmp_overlay/"; fi

    # Cleaning up dynamic files
    rm -f "$tmp_overlay/etc/pacman.conf"
    rm -f "$tmp_overlay/etc/pacman.d/mirrorlist"

    # 2. MOVE critical system files for the hooks to the permanent folder
    local system_conflicts=(
        "etc/os-release"
        "etc/pam.d/kde"
    )

    for file in "${system_conflicts[@]}"; do
        if [ -f "$tmp_overlay/$file" ]; then
            mkdir -p "$perm_overrides/$(dirname "$file")"
            mv "$tmp_overlay/$file" "$perm_overrides/$file"
        fi
    done

    # Copy service
    install -Dm644 "kader42-cleanup.service" "${pkgdir}/usr/lib/systemd/system/kader42-cleanup.service"
    
    # Create a symlink equivalent to “systemctl enable”
    mkdir -p "${pkgdir}/usr/lib/systemd/system/multi-user.target.wants"
    ln -s "../kader42-cleanup.service" "${pkgdir}/usr/lib/systemd/system/multi-user.target.wants/kader42-cleanup.service"
}