_cleanup_liveuser_legacy() {
    # IMPORTANT: If we are on the Live ISO, stop immediately!
    # We don't want to damage the Live user on the installation media.
    if [ -d /run/archiso ]; then
        return 0
    fi

    echo ":: Kader⁴² Legacy Cleanup executed..."

    # 1. Die sysusers-Konfiguration löschen, damit der Fehler NIE wieder auftritt
    if [ -f /etc/sysusers.d/liveuser.conf ]; then
        echo "--> Remove orphaned Liveuser configuration file..."
        rm -f /etc/sysusers.d/liveuser.conf
    fi

    # 2. Den durch den Xorg-Hook bereits wieder angelegten User endgültig löschen
    if id "liveuser" &>/dev/null; then
        echo "--> Remove the ‘liveuser’ account that was incorrectly restored..."
        userdel -r -f liveuser 2>/dev/null
    fi
}

_deploy_overlay() {
    echo "--- 🚀 Deploying Kader42 Configuration Overlays... ---"
    
    local source_dir="/usr/share/kader42/core-overlay"
    local etc_success=true
    local usr_success=true

    # 1. /etc/ kopieren und Erfolg prüfen
    if [ -d "$source_dir/etc" ]; then
        cp -Rf "$source_dir/etc/"* /etc/ 2>/dev/null
        if [ $? -ne 0 ]; then
            etc_success=false
        fi
    fi

    # 2. /usr/ kopieren und Erfolg prüfen
    if [ -d "$source_dir/usr" ]; then
        cp -Rf "$source_dir/usr/"* /usr/ 2>/dev/null
        if [ $? -ne 0 ]; then
            usr_success=false
        fi
    fi

    # 3. Bereinigung NUR, wenn alle Kopiervorgänge absolut fehlerfrei waren
    if [ "$etc_success" = true ] && [ "$usr_success" = true ]; then
        echo "--- 🧹 Overlay erfolgreich angewendet. Bereinige temporäre Daten... ---"
        rm -rf "$source_dir"
    else
        echo "--- ⚠️ FEHLER beim Kopieren des Overlays! Temporäre Daten wurden zur Sicherheit behalten. ---"
        return 1
    fi
}

_update_pacman_conf() {
    local target="/etc/pacman.conf"
    [ -f "$target" ] || return 0
    if ! grep -q "^\[kader42\]" "$target"; then
        cat << 'EOF' >> "$target"

[kader42]
SigLevel = Never
Server = http://repo.kader42.de/archlinux/$repo/os/$arch
EOF
    fi
}

_update_mirrorlist() {
    local target="/etc/pacman.d/mirrorlist"
    [ -f "$target" ] || return 0
    if ! grep -q "^Server = http://ftp.halifax.rwth-aachen.de/archlinux" "$target"; then
        cat << 'EOF' >> "$target"

Server = http://ftp.halifax.rwth-aachen.de/archlinux/$repo/os/$arch
EOF
    fi
}

post_install() {
    _cleanup_liveuser_legacy
    _deploy_overlay
    systemd-hwdb update
    udevadm trigger 2>/dev/null || true
    _update_pacman_conf
    _update_mirrorlist
    sudo systemctl enable --now /usr/lib/systemd/system/kader42-cleanup.service
}

post_upgrade() {
    post_install
}