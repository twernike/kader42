# }

post_upgrade() {
    # Startet den User-Dienst für alle aktuell aktiven Logind-Sessions neu
    for uid in $(loginctl list-sessions --no-legend | awk '{print $3}' | sort -u); do
        if [ "$uid" -ge 1000 ]; then
            systemctl --user -M "$uid@" restart kader42-tablet-event-listener.service 2>/dev/null || true
        fi
    done
}