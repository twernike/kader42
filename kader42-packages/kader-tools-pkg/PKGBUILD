# Maintainer: Thomas Wernike <support@kader42.de>
pkgname=kader42-convertible-tools
pkgver=2.0.0
pkgrel=3
pkgdesc="An event listener and a launcher switcher that ensures you have the Dash menu in tablet mode and the standard Start menu in laptop mode."
arch=('any')

source=(

)

sha256sums=(

)


package() {
    install -Dm644 "${startdir}/etc/mkinitcpio.conf.d/kader42-convertible.conf" "${pkgdir}/etc/mkinitcpio.conf.d/kader42-convertible.conf"
    install -Dm755 "${startdir}/usr/bin/kader42-plasma-convertible-switcher" "${pkgdir}/usr/bin/kader42-plasma-convertible-switcher"
    install -Dm755 "${startdir}/usr/bin/kader42-tablet-event-listener" "${pkgdir}/usr/bin/kader42-tablet-event-listener"
    install -Dm644 "${startdir}/usr/lib/systemd/user/kader42-tablet-event-listener.service" "${pkgdir}/usr/lib/systemd/user/kader42-tablet-event-listener.service"
    install -Dm644 "${startdir}/usr/lib/udev/rules.d/98-kader42-tablet-mode.rules" "${pkgdir}/usr/lib/udev/rules.d/98-kader42-tablet-mode.rules"
    install -Dm644 "${startdir}/usr/lib/udev/rules.d/99-kader42-tablet-switch.rules" "${pkgdir}/usr/lib/udev/rules.d/99-kader42-tablet-switch.rules"
    install -Dm644 "${startdir}/usr/share/libalpm/hooks/99-kader42-input-group.hook" "${pkgdir}/usr/share/libalpm/hooks/99-kader42-input-group.hook"
    install -Dm644 "${startdir}/usr/share/libalpm/hooks/kader42-mkinitcpio.hook" "${pkgdir}/usr/share/libalpm/hooks/kader42-mkinitcpio.hook"

}
