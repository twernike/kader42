#!/bin/bash
# Shebang: Specifies that the script is to be executed by the Bash shell.

# Ensure that the script has access to the D-Bus of the current user session (important for systemd user services).
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"

echo "[kader42-tablet-event-listener] Service started..."

NEW_MODE="$1"
STATE_FILE="/run/user/$(id -u)/kader42-plasma-convertible-state"

# Read current status (if available)
OLD_MODE=""
if [ -f "$STATE_FILE" ]; then
    OLD_MODE=$(cat "$STATE_FILE" 2>/dev/null)
fi

# If the requested mode is the same as the current one: Do nothing!
if [ "$NEW_MODE" = "$OLD_MODE" ]; then
    echo "[Kader42-Switch] Mode is already $NEW_MODE. Skipping re-configuration."
    exit 0
fi

# Ab hier folgt dein normaler Switch-Code...
echo "$NEW_MODE" > "$STATE_FILE"

# Read the chassis type from the system BIOS
CHASSIS_TYPE=$(cat /sys/class/dmi/id/chassis_type 2>/dev/null)
PRODUCT_NAME=$(cat /sys/class/dmi/id/product_name 2>/dev/null)

echo "[kader42-tablet-event-listener] Detected Chassis Type: ${CHASSIS_TYPE:-unknown}"

# AUTOMATIC OVERRIDE FOR CHASSIS TYPE 8, 9, 10 (Notebooks/Laptops)
# Catches devices like Dell Latitude 5320 2-in-1 with generic BIOS chassis IDs
if [[ "$CHASSIS_TYPE" =~ ^(8|9|10)$ ]]; then
    if grep -qE -i "Intel Virtual Buttons|gpio-keys|Tablet Mode Switch|Intel HID switches" /proc/bus/input/devices 2>/dev/null; then
        echo "[kader42-tablet-event-listener] Convertible switch hardware detected via input devices."
        echo "[kader42-tablet-event-listener] Overriding Chassis Type ${CHASSIS_TYPE:-unknown} -> 31"
        CHASSIS_TYPE=31
    elif [[ "$PRODUCT_NAME" =~ (2-in-1|2in1|Convertible|Flip|Yoga|x360) ]]; then
        echo "[kader42-tablet-event-listener] Convertible keyword found in DMI Product Name: '$PRODUCT_NAME'"
        echo "[kader42-tablet-event-listener] Overriding Chassis Type ${CHASSIS_TYPE:-unknown} -> 31"
        CHASSIS_TYPE=31
    fi
fi

echo "[kader42-tablet-event-listener] Effective Chassis Type: ${CHASSIS_TYPE:-unknown}"

LAST_MODE=""

# statefile is properly isolated for each user
STATE_FILE="/run/user/$(id -u)/chassis_state"

# HELPER FUNCTION: Counts real, physical keyboards in the system (filters out power buttons, etc.)
count_real_keyboards() {
    awk '/Name/{name=$0} /Handlers=.*kbd/{print name}' /proc/bus/input/devices | \
        grep -ivE "button|bus|camera|headset|mouse|switches" | \
        wc -l
}

# HELPER FUNCTION: Converts keyboard count to mode (0=Laptop, 1=Tablet)
get_mode_by_keyboard_count() {
    if [ "$(count_real_keyboards)" -gt 0 ]; then
        echo 0
    else
        echo 1
    fi
}

case "$CHASSIS_TYPE" in
    31)
        # --- CONVERTIBLE MODE (KWin DBus with hardware fallback) ---
        echo "[kader42-tablet-event-listener] Convertible detected. Initializing hybrid listener..."

        run_kwin_dbus_listener() {

            # 1. Retry loop: Wait until KWin is reachable via D-Bus (max. 15 seconds)
            local retries=0
            while [ $retries -lt 15 ]; do
                CURRENT_STATE=$(qdbus6 org.kde.KWin /org/kde/KWin org.kde.KWin.TabletModeManager.tabletMode 2>&1)
                local exit_code=$?

                if [ $exit_code -eq 0 ] && [ -n "$CURRENT_STATE" ] && [[ "$CURRENT_STATE" != *"Error"* ]]; then
                    break
                fi
                sleep 1
                ((retries++))
            done

            # If KWin does not respond after 15 seconds -> Switch to hardware fallback
            if [ $retries -eq 15 ]; then
                echo "[kader42-tablet-event-listener] Timeout: KWin DBus interface not accessible."
                return 1
            fi

            # 2. Error checking for the D-Bus status
            CURRENT_STATE=$(qdbus6 org.kde.KWin /org/kde/KWin org.kde.KWin.TabletModeManager.tabletMode 2>&1)
            local exit_code=$?

            if [ $exit_code -ne 0 ] || [ -z "$CURRENT_STATE" ] || [[ "$CURRENT_STATE" == *"Error"* ]]; then
                echo "[kader42-tablet-event-listener] The KWin DBus interface returns an error or is not ready: $CURRENT_STATE"
                return 1 # Fallback auslösen
            fi

            # 3. INITIAL STATE: Just capture, but DO NOT execute the switcher command!
            # This prevents Plasmashell from being disrupted during boot and ensures the background remains white..
            echo "[kader42-tablet-event-listener] DBus connection successful. Initial state: $CURRENT_STATE"
            
            if [ "$CURRENT_STATE" = "true" ]; then
                LAST_MODE=1
            else
                LAST_MODE=0
            fi

            # 4. EVENT LOOP: Listens in the background for ACTUAL mode changes during the session
            dbus-monitor --profile "type='signal',interface='org.kde.KWin.TabletModeManager',member='tabletModeChanged'" 2>/dev/null | while read -r line; do
                NEW_STATE=$(qdbus6 org.kde.KWin /org/kde/KWin org.kde.KWin.TabletModeManager.tabletMode 2>/dev/null)
                
                # If KWin crashes or returns invalid values -> break the loop
                if [ -z "$NEW_STATE" ] || [[ "$NEW_STATE" == *"Error"* ]]; then 
                    echo "[kader42-tablet-event-listener | Kader⁴² DBus] Connection to KWin lost whilst running!"
                    break 
                fi

                # Erst wenn sich der Status WIRKLICH ändert, wird der Switcher getriggert:
                if [ "$NEW_STATE" = "true" ] && [ "$LAST_MODE" -ne 1 ]; then
                    echo "[kader42-tablet-event-listener | Kader⁴² DBus Event] Mode changed → 1"
                    /usr/bin/kader42-plasma-convertible-switcher "1"
                    LAST_MODE=1
                elif [ "$NEW_STATE" = "false" ] && [ "$LAST_MODE" -ne 0 ]; then
                    echo "[kader42-tablet-event-listener | Kader⁴² DBus Event] Mode changed → 0"
                    /usr/bin/kader42-plasma-convertible-switcher "0"
                    LAST_MODE=0
                fi
            done
            
            return 1 # Triggers the libinput fallback if dbus-monitor ever exits
        }

        if ! run_kwin_dbus_listener; then
            echo "[kader42-tablet-event-listener] DBus listener failed or terminated."
            echo "[kader42-tablet-event-listener] Start STABLE FALLBACK: Dedicated hardware hinge switch..."
            
            TARGET_EV=$(grep -E 'Name="Intel Virtual Buttons"|Name="gpio-keys"' -B5 -A10 /proc/bus/input/devices | grep -oE 'event[0-9]+' | head -n 1)
            
            if [ -z "$TARGET_EV" ]; then
                echo "[kader42-tablet-event-listener] WARNING: No dedicated hardware device found. Use the global filter."
                DEV_ARG=""
            else
                DEV_ARG="--device /dev/input/$TARGET_EV"
                echo "[kader42-tablet-event-listener] Target Device Identified: /dev/input/$TARGET_EV"
            fi

            stdbuf -oL libinput debug-events $DEV_ARG | while read -r line; do
                if echo "$line" | grep -q "switch tablet-mode"; then
                    if echo "$line" | grep -q "state 1"; then
                        MODE=1  # Physically folded down
                    elif echo "$line" | grep -q "state 0"; then
                        MODE=0  # Normal Laptop Status
                    else
                        continue
                    fi
                    
                    # Debounce: Fire only when the state has actually changed
                    if [ "$MODE" != "$LAST_MODE" ]; then
                        echo "[kader42-tablet-event-listener] Hardware Mode changed → $MODE"
                        /usr/bin/kader42-plasma-convertible-switcher "$MODE"
                        LAST_MODE="$MODE"
                    fi
                fi
            done
        fi
        ;;

    32)
        # --- DETACHABLE MODE (Detachable Devices) ---
        echo "[kader42-tablet-event-listener] Detachable detected. Launching dynamic counting logic..."
        
        mkdir -p "$(dirname "$STATE_FILE")"
        touch "$STATE_FILE"

        # Determine initial state at service startup
        MODE=$(get_mode_by_keyboard_count)
        echo "[kader42-tablet-event-listener] Initial Detachable Mode → $MODE (Keyboards: $(count_real_keyboards))"
        /usr/bin/kader42-plasma-convertible-switcher "$MODE"
        LAST_MODE="$MODE"

        # Event loop: Wait for the udev signal in the state file in a resource-efficient manner
        if command -v inotifywait >/dev/null 2>&1; then
            echo "[kader42-tablet-event-listener] Using inotifywait for event triggering."
            while inotifywait -q -e modify "$STATE_FILE" >/dev/null; do
                MODE=$(get_mode_by_keyboard_count)
                if [ "$MODE" != "$LAST_MODE" ]; then
                    echo "[kader42-tablet-event-listener] Detachable mode changed → $MODE"
                    /usr/bin/kader42-plasma-convertible-switcher "$MODE"
                    LAST_MODE="$MODE"
                fi
            done
        else
            # Fallback if inotify-tools are missing
            echo "[kader42-tablet-event-listener] WARNING: 'inotifywait' not found! Falling back to 1s polling..."
            while true; do
                MODE=$(get_mode_by_keyboard_count)
                if [ "$MODE" != "$LAST_MODE" ]; then
                    echo "[Kader42 Tablet Event Listener] Detachable mode changed (polling) → $MODE"
                    /usr/bin/kader42-plasma-convertible-switcher "$MODE"
                    LAST_MODE="$MODE"
                fi
                sleep 1
            done
        fi
        ;;

    *)
        # --- PASSIVE FALLBACK (Standard Laptops / Desktops) ---
        # The device does not require tablet optimizations. 
        # The service exits gracefully immediately and uses 0% of resources.
        echo "[kader42-tablet-event-listener] Chassis Type '${CHASSIS_TYPE:-unknown}' does not require tablet mode. Exiting gracefully."
        exit 0
        ;;
esac