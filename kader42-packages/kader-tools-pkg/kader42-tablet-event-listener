#!/bin/bash
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"

echo "[Kader42 Tablet Event Listener] Service started..."

# Read the chassis type from the system BIOS
CHASSIS_TYPE=$(cat /sys/class/dmi/id/chassis_type 2>/dev/null)
echo "[Kader42 Tablet Event Listener] Detected Chassis Type: ${CHASSIS_TYPE:-unknown}"

LAST_MODE=""
STATE_FILE="/run/kader42/chassis_state"

# HELPER FUNCTION: Counts real, physical keyboards in the system (filters out power buttons, etc.)
count_real_keyboards() {
    awk '/Name/{name=$0} /Handlers=.*kbd/{print name}' /proc/bus/input/devices | \
        grep -ivE "button|bus|camera|headset|mouse|switches" | \
        wc -l
}

# HELPER FUNCTION: Converts keyboard count to mode (0=Laptop, 1=Tablet)
get_mode_by_keyboard_count() {
    if [ "$(count_real_keyboards)" -gt 0 ]; then
        echo 0
    else
        echo 1
    fi
}

case "$CHASSIS_TYPE" in
    31)
        # --- CONVERTIBLE MODE (Optimized Hardware Switch) ---
        echo "[Kader42 Tablet Event Listener] Convertible detected. Searching for dedicated hinge switch..."
        
        # Findet das spezifische eventX-Device für den Tabletschalter (z. B. Intel Virtual Buttons oder gpio-keys)
        # Dadurch muss die Bash-Schleife später nicht jede Mausbewegung verarbeiten.
        TARGET_EV=$(grep -E 'Name="Intel Virtual Buttons"|Name="gpio-keys"' -B5 -A10 /proc/bus/input/devices | grep -oE 'event[0-9]+' | head -n 1)
        
        if [ -z "$TARGET_EV" ]; then
            echo "[Kader42] WARNUNG: Kein dediziertes Hardware-Device gefunden. Nutze globalen Filter."
            DEV_ARG=""
        else
            DEV_ARG="--device /dev/input/$TARGET_EV"
            echo "[Kader42] Target Device identifiziert: /dev/input/$TARGET_EV"
        fi

        # stdbuf -oL erzwingt Line-Buffering. Zusammen mit dem dedizierten Device 
        # läuft das absolut verzögerungsfrei und mit praktisch 0% CPU-Last.
        stdbuf -oL libinput debug-events $DEV_ARG | while read -r line; do
            if echo "$line" | grep -q "switch tablet-mode"; then
                if echo "$line" | grep -q "state 1"; then
                    MODE=1  # Physisch umgeklappt
                elif echo "$line" | grep -q "state 0"; then
                    MODE=0  # Normaler Notebook-Zustand
                else
                    continue
                fi
                
                # Debounce: Nur feuern, wenn sich der Zustand wirklich geändert hat
                if [ "$MODE" != "$LAST_MODE" ]; then
                    echo "[Kader42 Tablet Event Listener] Hardware Mode changed → $MODE"
                    /usr/bin/kader42-plasma-convertible-switcher "$MODE"
                    LAST_MODE="$MODE"
                fi
            fi
        done
        ;;

    32)
        # --- DETACHABLE MODE (Detachable Devices) ---
        echo "[Kader42 Tablet Event Listener] Detachable detected. Launching dynamic counting logic..."
        
        mkdir -p "$(dirname "$STATE_FILE")"
        touch "$STATE_FILE"

        # Determine initial state at service startup
        MODE=$(get_mode_by_keyboard_count)
        echo "[Kader42 Tablet Event Listener] Initial Detachable Mode → $MODE (Keyboards: $(count_real_keyboards))"
        /usr/bin/kader42-plasma-convertible-switcher "$MODE"
        LAST_MODE="$MODE"

        # Event loop: Wait for the udev signal in the state file in a resource-efficient manner
        if command -v inotifywait >/dev/null 2>&1; then
            echo "[Kader42 Tablet Event Listener] Using inotifywait for event triggering."
            while inotifywait -q -e modify "$STATE_FILE" >/dev/null; do
                MODE=$(get_mode_by_keyboard_count)
                if [ "$MODE" != "$LAST_MODE" ]; then
                    echo "[Kader42 Tablet Event Listener] Detachable mode changed → $MODE"
                    /usr/bin/kader42-plasma-convertible-switcher "$MODE"
                    LAST_MODE="$MODE"
                fi
            done
        else
            # Fallback if inotify-tools are missing
            echo "[Kader42 Tablet Event Listener] WARNING: 'inotifywait' not found! Falling back to 1s polling..."
            while true; do
                MODE=$(get_mode_by_keyboard_count)
                if [ "$MODE" != "$LAST_MODE" ]; then
                    echo "[Kader42 Tablet Event Listener] Detachable mode changed (polling) → $MODE"
                    /usr/bin/kader42-plasma-convertible-switcher "$MODE"
                    LAST_MODE="$MODE"
                fi
                sleep 1
            done
        fi
        ;;

    *)
        # --- PASSIVE FALLBACK (Standard Laptops / Desktops) ---
        # The device does not require tablet optimizations. 
        # The service exits gracefully immediately and uses 0% of resources.
        echo "[Kader42 Tablet Event Listener] Chassis Type '${CHASSIS_TYPE:-unknown}' does not require tablet mode. Exiting gracefully."
        exit 0
        ;;
esac