#!/bin/bash

# Check if KWin DBus interface responds
# If not → trigger recovery

TIMEOUT=3

if ! timeout $TIMEOUT qdbus org.kde.KWin /KWin org.kde.KWin.supportInformation &>/dev/null; then
    echo "[kwin-watchdog] KWin unresponsive detected"

    # Try soft recovery first
    kwin_wayland --replace & disown

    # Fallback: restart plasmashell (optional safety net)
    sleep 2
    kquitapp6 plasmashell
    kstart6 plasmashell &
fi